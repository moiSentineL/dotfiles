#!/bin/bash

# ── Config ────────────────────────────────────────────────────────────────────
URL="https://cbseresults.nic.in/"           # ← change this
HASH_FILE="$HOME/.cache/site_monitor/last_hash"

# ── Display & DBus (required for cron → desktop notifications) ────────────────
export DISPLAY=:0
DBUS_FILE="/run/user/$(id -u)/bus"
if [ -S "$DBUS_FILE" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$DBUS_FILE"
fi

# ── Setup ─────────────────────────────────────────────────────────────────────
mkdir -p "$(dirname "$HASH_FILE")"

# ── Fetch & hash ──────────────────────────────────────────────────────────────
NEW_HASH=$(curl -s --max-time 15 "$URL" | sha256sum | cut -d' ' -f1)

if [ -z "$NEW_HASH" ]; then
    notify-send "Site Monitor" "⚠️ Could not reach $URL" \
        --icon=network-error --urgency=low
    exit 1
fi

# ── First run: save hash and exit quietly ─────────────────────────────────────
if [ ! -f "$HASH_FILE" ]; then
    echo "$NEW_HASH" > "$HASH_FILE"
    exit 0
fi

OLD_HASH=$(cat "$HASH_FILE")

# ── Compare ───────────────────────────────────────────────────────────────────
if [ "$NEW_HASH" != "$OLD_HASH" ]; then
    echo "$NEW_HASH" > "$HASH_FILE"
    dunstify "🔔 Site Updated" "$URL has changed." \
        --icon=software-update-available \
        -u critical \
        -t 15000
fi

# No notification if unchanged — silent exit
